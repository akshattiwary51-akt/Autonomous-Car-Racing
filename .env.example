# Copy to .env if you want to set any of these. None are required.
# Headless rendering (servers, Colab). The code already sets this automatically when no window is requested.
SDL_VIDEODRIVER=dummy
# Limit CPU threads used by NumPy/OpenCV when running several trainings in parallel.
OMP_NUM_THREADS=2
# Pick the GPU for training (or use experiment.device in the config).
# CUDA_VISIBLE_DEVICES=0
# Optional: where TensorBoard is served from when using helper scripts.
TENSORBOARD_PORT=6006
